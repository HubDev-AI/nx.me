# ──────────────────────────────────────────────────────────────────────────────
# NXME — Local Development Environment
# Copy to .env and fill in real values.
# Never commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# LOG_LEVEL — DEBUG | INFO | WARNING | ERROR (case-insensitive). Empty
# defers to APP_ENV: development → DEBUG, anything else → INFO. In dev
# DEBUG mode the full Anthropic prompts AND responses are logged
# automatically (see ADVISOR_DEBUG_LOG_PROMPT below) so the advisor
# pipeline is fully traceable from a tail of one log stream.
LOG_LEVEL=debug
SECRET_KEY=CHANGE_ME_32_chars_minimum_random_string

# Admin API (tier management + ops endpoints)
ADMIN_API_KEY=CHANGE_ME_32_chars_minimum_random_string

# ── Supabase ──────────────────────────────────────────────────────────────────
# Use nxme-dev project (free tier) for local development
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME   # server-side only; never expose to clients
SUPABASE_JWT_SECRET=CHANGE_ME         # from Supabase project Settings → API

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local: Docker container (see docker-compose.yml)
# Staging/Prod: Upstash Redis connection string
REDIS_URL=redis://:localdev@localhost:6379/0

# ── Image Generation — fal.ai ─────────────────────────────────────────────────
FAL_API_KEY=CHANGE_ME

# ── NSFW Screening — AWS Rekognition ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1

# ── Payments — Stripe ─────────────────────────────────────────────────────────
# Use test mode keys (sk_test_...) for local development
STRIPE_API_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME    # from: stripe listen --forward-to localhost:8000/webhooks/stripe
# Publishable key (pk_test_...) — returned to mobile Payment Sheet bootstrap
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# ── Advisor — Chat (Anthropic Claude) ────────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME
ADVISOR_PERSONA_NAME=Ada                  # Persona name used in nudge/chat prompts
ADVISOR_CONTEXT_MEMORY_LIMIT=20           # Top-K memories injected per advisor turn
ADVISOR_MEMORY_CAP=500                    # Max memories per user (spec §10)
ADVISOR_CONTEXT_TOKEN_BUDGET=5000         # Max input tokens per chat call (spec §10)
# Full-payload logging for every Anthropic call: prompts AND responses.
# Auto-enabled when APP_ENV=development AND effective LOG_LEVEL=DEBUG, so
# leaving this empty in dev still gives you the full pipeline. Setting
# true forces it on in any environment — DO NOT enable in production:
# leaks raw user content + signed URLs into log aggregators.
ADVISOR_DEBUG_LOG_PROMPT=false
# Plan 2026-04-17-003 Unit 4 — chat context 4th system block (nudges).
# Ada's chat turn now includes the user's most recent nudges as a
# dedicated system block (separate from memories). Cap at the newest N
# nudges within the trailing AGE_DAYS window — everything older or beyond
# the cap is ignored. Read-only: the context fetch never mutates read_at.
ADVISOR_CONTEXT_NUDGE_LIMIT=5
ADVISOR_CONTEXT_NUDGE_AGE_DAYS=14
# Plan 2026-04-17-003 Unit 9 — advisor MCP-style tool surface.
# Ada invokes named server-side tools (get_style_profile, get_latest_generation,
# etc.) on demand. MAX_TOOL_ROUNDS caps tool-use rounds per user turn —
# remaining calls after the cap receive "tool round cap exceeded" results so
# the model finishes its text rather than looping. TOOLS_ENABLED is the kill
# switch: False reverts to the eager-vision path without tool advertising.
ADVISOR_MAX_TOOL_ROUNDS=3
ADVISOR_TOOLS_ENABLED=true
# Plan 2026-04-17-003 Unit 8 — vision-grounded post-generation nudges.
# On every completed glow-up (and the analysis endpoint's existing
# post_analysis path) the nudge worker calls the vision-capable Haiku
# model with the before/after images, the user's stable style_profile,
# and the last N nudge bodies + observation_tags as "do not repeat"
# context. The model returns strict JSON {"body", "observation_tag"};
# parse failure drops the nudge (no retry, next generation gets its
# own chance). RECENT_CONTEXT_LIMIT caps how many prior nudges feed
# the prompt. Rapid-retry dedup: if a post_glowup fires within
# RAPID_RETRY_MINUTES for the same upload_id, the second run is
# skipped. The legacy POST_ANALYSIS_NUDGE_COOLDOWN_MINUTES knob is
# deprecated (default 0); dedup now lives in the model's context.
ADVISOR_NUDGE_RECENT_CONTEXT_LIMIT=5
ADVISOR_POST_GLOWUP_RAPID_RETRY_MINUTES=5
# DEPRECATED — keep at 0 unless rolling back Unit 8.
ADVISOR_POST_ANALYSIS_NUDGE_COOLDOWN_MINUTES=0

# ── Advisor — Embeddings ─────────────────────────────────────────────────────
# Backend used for memory embeddings. Independent from chat backend so you
# can pair Anthropic chat with Ollama embeddings (free local) or with
# OpenAI embeddings (production).
# OPENAI_API_KEY required when ADAPTER__EMBEDDING_ADAPTER=openai.
OPENAI_API_KEY=CHANGE_ME
# OLLAMA_* required when ADAPTER__EMBEDDING_ADAPTER=ollama (default for dev).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text   # 768-dim native; matches DB column

# ── Platform Limits (app-wide, not tier-specific) ─────────────────────────────
MAX_UPLOAD_SIZE_MB=20
MAX_IMAGE_DIMENSION_PX=8192
SIGNED_URL_EXPIRY_SECONDS=3600
# Must stay above the current per-gen model cost (fal NANO_BANANA_2 is $0.08,
# PRO is $0.15); $0.20 catches a 2-3x runaway without tripping on normal ops.
IMAGE_GEN_COST_CEILING_USD=0.20
GENERATION_TIMEOUT_SECONDS=60
# Warn-level threshold — should sit below the ceiling, above normal per-gen cost.
CREDIT_COST_ALERT_USD=0.12

# ── Dev-only result-screen repro harness ──────────────────────────────────────
# Both default to off. Set FORCE_404 to N seconds to make GET /v1/jobs/{id}
# return 404 for the first N seconds after a job's created_at — exercises the
# mobile waiting view's grace window + hard-timeout backstop. Set
# EMIT_NULL_URLS=true to make the worker write after_image_url=NULL on
# completed jobs — exercises the "completed with missing URLs" waiting branch.
# Leave both off in production.
DEV_GLOWUP_FORCE_404_FOR_NEW_JOBS_SECONDS=0
DEV_GLOWUP_EMIT_NULL_URLS_ON_COMPLETE=false

# ── Adapter Selection ─────────────────────────────────────────────────────────
# Change to "mock" to run without real API keys (local testing)
ADAPTER__NSFW_ADAPTER=rekognition          # rekognition | sightengine | mock
ADAPTER__FACE_ANALYSIS_ADAPTER=mediapipe   # mediapipe | mock
ADAPTER__IMAGE_GENERATION_ADAPTER=fal_ai  # fal_ai | replicate | mock
ADAPTER__LLM_ADAPTER=anthropic             # anthropic | openai | mock
ADAPTER__EMBEDDING_ADAPTER=ollama          # openai | ollama | mock
ADAPTER__STORAGE_ADAPTER=supabase          # supabase | s3 | local
ADAPTER__PAYMENT_ADAPTER=stripe            # stripe | mock

# ── Google OAuth (used by Supabase GoTrue + mobile app) ─────────────────────
# Web Client ID — audience for id_token verification (Supabase + @react-native-google-signin)
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# Web Client Secret — required by Supabase GoTrue config
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
# iOS Client ID — native Google Sign-In on iOS
GOOGLE_IOS_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# ── Auth Provider Flags ──────────────────────────────────────────────────────
# Toggle login methods per environment. Disabled = API rejects + mobile hides button.
AUTH_PROVIDER_GOOGLE_ENABLED=true
AUTH_PROVIDER_APPLE_ENABLED=false
AUTH_PROVIDER_EMAIL_ENABLED=false
AUTH_PROVIDER_TIKTOK_ENABLED=false

# ── Feature Flags ────────────────────────────────────────────────────────────
# Unified flag registry exposed via GET /v1/features and consumed by mobile.
# Prod-safe defaults are baked into the Python Settings class; override here
# per environment. Dev testing preset: AUTH + ONBOARDING off, SOCIAL off.
#
# Auth/access flags (independent — flip per concern):
#   FEATURE_AUTH_REQUIRED   — auth layer:        false ⇒ accept X-Guest-Token
#   FEATURE_PREMIUM_BYPASS  — entitlement layer: true  ⇒ skip require_feature gate
# Combined: AUTH=false + BYPASS=true = full guest access to premium routes.
FEATURE_AUTH_REQUIRED=false          # prod: true — set false to skip login in dev
FEATURE_SOCIAL_ENABLED=false         # prod: false until social launches
FEATURE_SHARE_ENABLED=true           # prod: true — Share button on result screen
FEATURE_ONBOARDING_ENABLED=false     # prod: true — onboarding wizard
FEATURE_PREMIUM_BYPASS=false         # prod: false — dev-only: bypass require_feature gates
# ADVISOR_ENABLED is the legacy name for the advisor flag (already above).

FAL_KEY=CHANGE_ME
SUPABASE_PUBLIC_URL=
