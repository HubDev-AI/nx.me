# Backend API base URL — used by server components at build/request time
# API_URL is used server-side (SSR/ISR); NEXT_PUBLIC_API_URL is baked into client bundles.
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Secret used to authenticate on-demand revalidation requests from the backend
REVALIDATION_SECRET=change-me-to-a-random-secret

# App store links
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/nxme/idXXXXXXXXX
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=ai.nxme.app

# Universal link base (app installed deep-link)
NEXT_PUBLIC_APP_BASE_URL=https://nxme.ai
