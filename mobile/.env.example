# ── Mobile Dev Environment ───────────────────────────────────────────────────
# Copy to .env and fill in values. Read by app.config.ts at build time.
# These values are embedded in the app binary — no secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API — use your machine's LAN IP for simulator access
API_BASE_URL=http://YOUR_LAN_IP:8000

# Google OAuth — Client IDs (public, not secrets)
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# Stripe (publishable key only — pk_test_... not sk_test_...)
STRIPE_PUBLISHABLE_KEY=

# Apple
APPLE_CLIENT_ID=
APPLE_MERCHANT_ID=merchant.ai.nxme.app

# TikTok
TIKTOK_CLIENT_KEY=

# Dev feature-flag overrides — comma list of short names to force-disable on
# top of the backend GET /v1/features response. Dev builds only.
#   social      → social_enabled=false (hides Home/Profile tabs)
#   share       → share_enabled=false (hides Share CTA on result)
#   onboarding  → onboarding_enabled=false (skips onboarding route)
#   advisor     → advisor_enabled=false (hides Advisor tab)
# Example: DEV_DISABLE_FEATURES=social,onboarding
DEV_DISABLE_FEATURES=

# Sentry DSN — leave blank to disable crash reporting (logs warning in dev)
EXPO_PUBLIC_SENTRY_DSN=
